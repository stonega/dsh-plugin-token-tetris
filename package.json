{
  "name": "dsh-tetris-plugin",
  "version": "0.1.0",
  "description": "Token-rate-driven Tetris overlay for the DeepSeek Harness Web GUI",
  "author": "stonega",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "bun tests/game.test.ts && bun tests/token-rate.test.ts",
    "prepack": "node scripts/build.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "tetris",
    "game"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stonega/dsh-tetris-plugin.git"
  },
  "homepage": "https://github.com/stonega/dsh-tetris-plugin#readme",
  "bugs": {
    "url": "https://github.com/stonega/dsh-tetris-plugin/issues"
  }
}
